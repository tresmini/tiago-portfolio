---
/**
 * CaseStudyLayout.astro — Shared shell for all case study pages.
 *
 * Every case study page imports this instead of Layout directly.
 * It wraps Layout and adds the case study chrome:
 *   - Back link to /work
 *   - Title block (company, role, period, tags, hero metric)
 *   - <slot /> where the actual case study content goes
 *
 * Props:
 *   company    — company name, e.g. "Cobli"
 *   role       — your title, e.g. "Senior Product Manager"
 *   period     — date range, e.g. "Jul 2024 — Jan 2026"
 *   tags       — array of domain strings, e.g. ["Fleet Tech", "AI Products"]
 *   metric     — the headline number to call out, e.g. "70% fewer false positives"
 *   metricNote — short context for the metric, e.g. "AI alert accuracy improvement"
 */
import Layout from './Layout.astro';

interface Props {
  company: string;
  role: string;
  period: string;
  tags: string[];
  metric: string;
  metricNote: string;
}

const { company, role, period, tags, metric, metricNote } = Astro.props;
---

<Layout title={`${company} — Tiago Resmini`}>

  <div class="case-study-wrap">

    <!-- ── Back navigation ──────────────────────────────────
         Always gives the reader a clear way back to /work.
    ───────────────────────────────────────────────────── -->
    <div class="container">
      <a href="/work" class="back-link">← Back to work</a>
    </div>

    <!-- ── Case Study Header ────────────────────────────────
         The first thing the reader sees — must orient them
         in 5 seconds: company, what you did, when, domains.
         The metric callout gives a reason to keep reading.
    ───────────────────────────────────────────────────── -->
    <header class="cs-header">
      <div class="container">
        <span class="section-label">{role}</span>
        <h1 class="cs-company">{company}</h1>
        <p class="cs-period">{period}</p>

        <div class="cs-tags">
          {tags.map(tag => <span class="tag">{tag}</span>)}
        </div>

        <!-- Headline metric — the single biggest result.
             Draws the eye and anchors why this case study matters. -->
        <div class="cs-metric">
          <span class="cs-metric-number">{metric}</span>
          <span class="cs-metric-note">{metricNote}</span>
        </div>
      </div>
    </header>

    <!-- ── Case Study Body ───────────────────────────────────
         <slot /> is where each individual case study page
         injects its own content: context, problem, process,
         solution, impact, role, and lessons.
    ───────────────────────────────────────────────────── -->
    <div class="cs-body">
      <div class="container">
        <slot />
      </div>
    </div>

    <!-- ── Footer nav ───────────────────────────────────────
         Gives the reader somewhere to go after finishing.
    ───────────────────────────────────────────────────── -->
    <div class="cs-footer-nav">
      <div class="container">
        <a href="/work" class="back-link">← Back to all case studies</a>
      </div>
    </div>

  </div>

</Layout>

<style>
  /* ── Back link ────────────────────────────────────────── */
  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    padding: 32px 0 0;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  /* ── Header ──────────────────────────────────────────── */
  .cs-header {
    padding: 32px 0 64px;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 0;
  }

  .cs-company {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-top: 8px;
    margin-bottom: 8px;
  }

  .cs-period {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin-bottom: 20px;
    max-width: none; /* override global p constraint */
  }

  .cs-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 40px;
  }

  .tag {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 4px 14px;
  }

  /* ── Metric callout ──────────────────────────────────── */
  .cs-metric {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 24px 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  /* The big number — visually dominant */
  .cs-metric-number {
    font-size: clamp(1.4rem, 2.5vw, 1.9rem);
    font-weight: 700;
    color: var(--color-accent);
    white-space: nowrap; /* keep the metric on one line */
  }

  .cs-metric-note {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    max-width: 40ch;
  }

  /* Mobile: stack metric vertically so long text doesn't overflow */
  @media (max-width: 640px) {
    .cs-metric {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }

    .cs-metric-number {
      white-space: normal; /* allow wrapping on small screens */
    }
  }

  /* ── Body ────────────────────────────────────────────── */
  .cs-body {
    padding: 64px 0;
  }

  /* ── Footer nav ──────────────────────────────────────── */
  .cs-footer-nav {
    border-top: 1px solid var(--color-border);
    padding-bottom: 0;
  }

  /* ── Case study content sections ───────────────────────
     These classes are used by the individual case study
     pages via the <slot />. Defined here so they're
     consistent across all three pages.
  ────────────────────────────────────────────────────── */

  /* Override global section padding — cs-body handles it */
  :global(.cs-section) {
    margin-bottom: 56px;
  }

  :global(.cs-section:last-child) {
    margin-bottom: 0;
  }

  :global(.cs-section-label) {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 12px;
  }

  :global(.cs-section h2) {
    font-size: 1.35rem;
    margin-bottom: 16px;
  }

  :global(.cs-section p) {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text-primary);
    margin-bottom: 16px;
    max-width: 65ch;
  }

  :global(.cs-section p:last-child) {
    margin-bottom: 0;
  }

  /* Bullet list inside a case study section */
  :global(.cs-list) {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    max-width: 65ch;
  }

  :global(.cs-list li) {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-primary);
    padding-left: 20px;
    position: relative;
  }

  /* Custom bullet: accent-colored dash */
  :global(.cs-list li::before) {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: 700;
  }

  /* Impact highlight box — for the key results */
  :global(.cs-impact-box) {
    background-color: var(--color-surface);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 8px 8px 0;
    padding: 20px 24px;
    margin-top: 20px;
    max-width: 65ch;
  }

  :global(.cs-impact-box p) {
    margin-bottom: 8px;
    font-size: 0.975rem;
  }

  :global(.cs-impact-box p:last-child) {
    margin-bottom: 0;
  }

  :global(.cs-impact-box strong) {
    color: var(--color-text-primary);
    font-weight: 700;
  }
</style>
